NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=/var/lib/xiangwu/gateway/lead-gateway.db
REDIS_URL=redis://127.0.0.1:6379/3

BAIDU_WEBHOOK_TOKEN=replace-with-baidu-token
TENCENT_WEBHOOK_TOKEN=replace-with-tencent-token
XIAOHONGSHU_WEBHOOK_TOKEN=replace-with-xiaohongshu-token
XIAOHONGSHU_WEBHOOK_TOKENS=
MANUAL_FORM_TOKEN=replace-with-manual-token

LEAD_PIPELINE_MODE=dual-write
KXONE_API_BASE_URL=http://127.0.0.1:18081
KXONE_GATEWAY_HMAC_SECRET=replace-with-shared-gateway-hmac-secret
KXONE_REQUEST_TIMEOUT_MS=5000
RECONCILIATION_HASH_KEY=replace-with-independent-reconciliation-key
DUAL_WRITE_RECONCILIATION_DAYS=7

LOG_LEVEL=info
MASK_PHONE_IN_LOG=true
