SERVER_ENV=prod
SERVER_HOST=127.0.0.1
SERVER_PORT=18081
SERVER_PUBLIC_BASE_URL=https://kxone.whxiangwu.com
TRUSTED_PROXIES=127.0.0.1,::1
CORS_ALLOWED_ORIGINS=https://kxone.whxiangwu.com,https://whxiangwu.com,https://www.whxiangwu.com
CRM_BOOTSTRAP_USERNAME=admin
CRM_BOOTSTRAP_PASSWORD=replace-with-a-strong-initial-password
WORKER_METRICS_ADDR=127.0.0.1:9091
WORKER_CONCURRENCY=10

DB_DRIVER=sqlite
DB_NAME=/var/lib/xiangwu/kxone/kxone.db
DB_MAX_CONNS=4
MIGRATIONS_DIR=/opt/xiangwu/apps/kxone/migrations
ENABLE_AUTO_MIGRATE=false
DB_LOG_LEVEL=warn

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

JWT_SECRET=replace-with-random-secret
FIELD_ENCRYPTION_KEY=replace-with-32-byte-key
MOBILE_HASH_KEY=replace-with-independent-key


AD_LEAD_DEFAULT_MANAGER_USERID=replace-with-manager-userid
AD_LEAD_WEBHOOK_SECRET=replace-with-webhook-secret
AD_LEAD_SIGNATURE_TOLERANCE=300
AD_LEAD_TRUSTED_GATEWAY_IPS=127.0.0.1
AD_LEAD_GATEWAY_ENABLED=true
AD_LEAD_GATEWAY_HMAC_SECRET=replace-with-shared-gateway-hmac-secret
AD_LEAD_GATEWAY_SIGNATURE_TOLERANCE=300
AD_LEAD_GATEWAY_PUBLIC_BASE_URL=https://leads.whxiangwu.com
