[Unit]
Description=Xiangwu advertising lead gateway
After=network-online.target redis-server.service kxone-server.service
Wants=network-online.target

[Service]
Type=simple
User=xiangwu
Group=xiangwu
WorkingDirectory=/opt/xiangwu/apps/lead-gateway
EnvironmentFile=/etc/xiangwu/gateway.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/opt/xiangwu/scripts/validate-production-env.sh gateway
ExecStart=/usr/bin/env node /opt/xiangwu/apps/lead-gateway/dist/server.js
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/xiangwu/gateway

[Install]
WantedBy=multi-user.target
