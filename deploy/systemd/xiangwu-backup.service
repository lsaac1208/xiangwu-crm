[Unit]
Description=Create Xiangwu platform online-consistent backup
After=kxone-server.service lead-gateway.service

[Service]
Type=oneshot
User=xiangwu
Group=xiangwu
EnvironmentFile=/etc/xiangwu/backup.env
ExecStart=/opt/xiangwu/scripts/backup-platform.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xiangwu /var/backups/xiangwu

