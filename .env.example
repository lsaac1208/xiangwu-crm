# Root development orchestration. Copy to .env and replace secrets when needed.
RUNTIME_DIR=.runtime
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0

KXONE_HOST=127.0.0.1
KXONE_PORT=8080
KXONE_WORKER_METRICS_PORT=9091
H5_HOST=127.0.0.1
H5_PORT=5173

SERVER_PUBLIC_BASE_URL=http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4321
CRM_BOOTSTRAP_USERNAME=admin
CRM_BOOTSTRAP_PASSWORD=admin12345
AD_LEAD_DEFAULT_MANAGER_USERID=dev-manager
AD_LEAD_WEBHOOK_SECRET=dev-ad-lead-webhook-secret
AD_LEAD_GATEWAY_ENABLED=false
