{
  "name": "kxone-h5",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:tokens": "node scripts/validate-design-tokens.mjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test",
    "test:regression": "npm run build && playwright test --config playwright.regression.config.js",
    "test:workflow": "npm run build && playwright test --config playwright.strengthen.config.js",
    "test:visual:update": "playwright test --update-snapshots",
    "test:ui": "npm run build && playwright test --config playwright.audit.config.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dompurify": "3.4.17",
    "echarts": "^6.1.0",
    "markdown-it": "^15.0.3",
    "pinia": "^2.1.7",
    "vant": "^4.8.1",
    "vue": "^3.5.44",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^28.1.0",
    "terser": "^5.50.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vitest": "4.1.12"
  }
}
