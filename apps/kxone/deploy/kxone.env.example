# Install as /etc/kxone/kxone.env with mode 0640 and owner root:kxone.
# Replace every change-me value before starting either service.

SERVER_ENV=prod
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_PUBLIC_BASE_URL=https://crm.example.com
TRUSTED_PROXIES=127.0.0.1,::1
CORS_ALLOWED_ORIGINS=https://www.example.com
CRM_BOOTSTRAP_USERNAME=admin
CRM_BOOTSTRAP_PASSWORD=replace-with-a-strong-initial-password
SERVER_MAX_BODY_BYTES=16777216
WORKER_METRICS_ADDR=127.0.0.1:9091
WORKER_CONCURRENCY=10

DB_DRIVER=sqlite
DB_NAME=/opt/kxone/data/kxone.db
DB_MAX_CONNS=4
MIGRATIONS_DIR=/opt/kxone/migrations
ENABLE_AUTO_MIGRATE=false
DB_LOG_LEVEL=warn

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=
JWT_ACCESS_EXPIRY=7200
JWT_REFRESH_EXPIRY=604800
FIELD_ENCRYPTION_KEY=
MOBILE_HASH_KEY=


AD_LEAD_DEFAULT_MANAGER_USERID=
AD_LEAD_WEBHOOK_SECRET=
AD_LEAD_SIGNATURE_TOLERANCE=300
AD_LEAD_TRUSTED_GATEWAY_IPS=
AD_LEAD_GATEWAY_ENABLED=false
AD_LEAD_GATEWAY_HMAC_SECRET=
AD_LEAD_GATEWAY_SIGNATURE_TOLERANCE=300

# Used by the local backup and cleanup systemd jobs.
KXONE_BACKUP_DIR=/opt/kxone/backups/db
KXONE_BACKUP_RETENTION_DAYS=30

# AI analysis defaults. Administrators can configure URL/model/encrypted API key
# from CRM system settings; environment credentials are optional bootstrap only.
AGENT_ENABLED=false
AGENT_MODEL=qwen3.8-max
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_STORAGE_DIR=/var/lib/kxone/agent
# DeepSeek as primary (non-thinking tool mode is applied automatically for
# deepseek-* models). Configure the other provider as backup in system settings.
# Re-run isolated real-model acceptance and update prices when switching.
# AGENT_MODEL=deepseek-v4-pro
# AGENT_BASE_URL=https://api.deepseek.com/chat/completions
