# 环境配置示例（开发环境）
# 复制此文件为 .env 并修改实际配置

# 服务配置
SERVER_PORT=8080
SERVER_ENV=dev
SERVER_PUBLIC_BASE_URL=http://localhost:8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_HEADER_TIMEOUT=5s
SERVER_MAX_BODY_BYTES=16777216
SERVER_MAX_HEADER_BYTES=1048576
WORKER_METRICS_ADDR=127.0.0.1:9091
WORKER_CONCURRENCY=10
# Worker 监控端点：GET /health、GET /metrics。默认仅监听本机。
TRUSTED_PROXIES=127.0.0.1,::1
CORS_ALLOWED_ORIGINS=

# 首次启动时创建管理员账号。开发环境未设置密码时使用 admin / admin12345；生产必须显式设置强密码。
CRM_BOOTSTRAP_USERNAME=admin
CRM_BOOTSTRAP_PASSWORD=

# 字段级加密配置：生产环境必填，32 字节原文或 base64 编码 32 字节密钥
# 生成示例：openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# 手机号精确搜索 HMAC 索引密钥：生产环境必填，建议与 FIELD_ENCRYPTION_KEY 使用不同密钥
# 生成示例：openssl rand -base64 32
MOBILE_HASH_KEY=

# 数据库配置
# 驱动类型: sqlite / mysql
DB_DRIVER=sqlite

# SQLite 配置（DB_DRIVER=sqlite 时）
# DB_NAME=kxone.db

# MySQL 配置（DB_DRIVER=mysql 时）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
# DB_NAME=kxone
DB_MAX_CONNS=20
MIGRATIONS_DIR=migrations
# 生产默认 false，开发默认 true；生产 schema 变更应走 migrations/*.sql
ENABLE_AUTO_MIGRATE=true

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 广告线索与官网公开表单的默认派发主管
AD_LEAD_DEFAULT_MANAGER_USERID=manager_username
# 广告线索 webhook 共享密钥。生产建议必填；支持 HMAC 签名或 Bearer/shared-secret 头。
AD_LEAD_WEBHOOK_SECRET=
AD_LEAD_SIGNATURE_TOLERANCE=300
# 已验证平台 token 的内部 lead-gateway 转发 IP/CIDR，逗号分隔；公网直连仍需密钥/签名。
AD_LEAD_TRUSTED_GATEWAY_IPS=
AD_LEAD_GATEWAY_ENABLED=false
AD_LEAD_GATEWAY_HMAC_SECRET=
AD_LEAD_GATEWAY_SIGNATURE_TOLERANCE=300

# JWT 配置
JWT_SECRET=replace_with_long_random_secret
JWT_ACCESS_EXPIRY=7200
JWT_REFRESH_EXPIRY=604800
